@page "/compilador"
@rendermode InteractiveServer
@using CompiladorCPLUS.Models
@using CompiladorCPLUS.Service
@inject CompiladorService compiladorService
@inject LexerService lexerService
@inject ParserService parserService
@inject SemanticService semanticService
@inject IJSRuntime JSRuntime

<PageTitle>IDE C+ Interactiva | UCNE</PageTitle>

<div class="container-fluid mt-4 px-4">
    <div class="row">
        <div class="col-lg-7">
            <div class="card bg-dark text-white shadow-lg border-0 mb-4">
                <div class="card-header border-secondary bg-gradient d-flex justify-content-between align-items-center py-3">
                    <h4 class="mb-0 text-primary fw-bold">
                        <i class="bi bi-code-slash me-2"></i>IDE INTERACTIVO
                    </h4>
                    <div class="authors-badge">
                        <span class="text-white-50 small text-uppercase me-2">By:</span>
                        <span class="badge rounded-pill bg-primary text-white px-3 py-2 fw-bold shadow-sm border border-info">
                            <i class="bi bi-person-badge-fill me-1"></i> Luis Gabriel & James Ureña
                        </span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <textarea @bind="compilacion.Codigo" class="form-control bg-black text-success font-monospace p-4 border-0" rows="18" style="outline: none; resize: none; font-size: 1rem;"></textarea>
                </div>
                <div class="card-footer border-secondary bg-dark p-2 d-flex justify-content-center">
                    <button class="btn btn-primary fw-bold shadow-sm px-5" @onclick="Compilar">
                        <i class="bi bi-play-fill me-1"></i> EJECUTAR PROGRAMA
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="bg-black text-white p-4 rounded shadow-lg mb-4" style="min-height: 480px; border-left: 5px solid #0d6efd; display: flex; flex-direction: column;">
                <div class="text-info border-bottom border-secondary pb-2 mb-3 small d-flex justify-content-between font-monospace">
                    <span class="fw-bold"><i class="bi bi-terminal me-2"></i>TERMINAL DE SALIDA</span>
                    <button class="btn btn-sm btn-outline-secondary py-0" style="font-size: 0.7rem;" @onclick='() => SalidaTerminal = ""'>LIMPIAR</button>
                </div>
                <div class="font-monospace flex-grow-1" style="white-space: pre-wrap; font-size: 0.95rem; line-height: 1.5;">
                    @if (!string.IsNullOrEmpty(SalidaTerminal))
                    {
                        <span>@SalidaTerminal</span>
                    }
                    else
                    {
                        <span class="text-muted small">> Esperando ejecución...</span>
                    }
                </div>
            </div>

            @if (errores.Any())
            {
                <div class="alert alert-danger bg-dark text-danger border-danger shadow-sm font-monospace">
                    <div class="fw-bold mb-2 border-bottom border-danger pb-1">ERRORES ENCONTRADOS:</div>
                    @foreach (var error in errores)
                    {
                        <div class="mb-1 small"><i class="bi bi-exclamation-octagon-fill me-2"></i>@error</div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .authors-badge .badge {
        transition: all 0.3s ease;
        cursor: default;
    }
    .authors-badge .badge:hover {
        background-color: #0b5ed7 !important;
        transform: scale(1.05);
        box-shadow: 0 0 15px rgba(13, 110, 253, 0.4);
    }
    .bg-black { background-color: #000 !important; }
    textarea::placeholder { color: #2d5a2d; }
    .card-footer .btn {
        padding-top: 0.4rem;
        padding-bottom: 0.4rem;
    }
</style>

<script>
    window.pedirDato = (mensaje) => {
        return prompt(mensaje) || "";
    };
</script>

@code {
    private Compilacion compilacion = new();
    private List<string> errores = new();
    private Dictionary<string, string> ValoresActuales = new();
    private string SalidaTerminal = "";

    private async Task Compilar()
    {
        SalidaTerminal = "> Compilando código...\n";
        
        var errLex = lexerService.ValidarCodigo(compilacion.Codigo);
        var errSin = parserService.AnalizarSintaxis(compilacion.Codigo);
        var errSem = semanticService.AnalizarSemantica(compilacion.Codigo);

        errores = errLex.Concat(errSin).Concat(errSem).ToList();
        ValoresActuales = semanticService.ObtenerValores();

        if (!errores.Any())
        {
            SalidaTerminal += "> Análisis exitoso. Ejecutando binario...\n------------------------\n";
            await EjecutarInterpretacion();
        }
        else
        {
            SalidaTerminal += "!! Errores detectados en la compilación.\n";
        }

        compilacion.TieneErrores = errores.Any();
        compilacion.Fecha = DateTime.Now;
        compilacion.ResultadoAnalisis = errores.Any() ? "Errores" : "Exito";
        await compiladorService.Guardar(compilacion);
    }

  private async Task EjecutarInterpretacion()
{
    var lineas = compilacion.Codigo.Split('\n');
    bool saltarBloqueElse = false;
    bool ejecutandoBloqueValido = true;

    foreach (var lineaRaw in lineas)
    {
        var l = lineaRaw.Trim();
        if (string.IsNullOrEmpty(l) || l.StartsWith("#") || l.StartsWith("using") || l.Contains("main") || l == "}") 
        {
            if(l == "}") ejecutandoBloqueValido = true; 
            continue;
        }
        if (l.Contains("if ("))
        {
            var condicion = l.Split('(', ')')[1]; 
            var partes = condicion.Split(new[] { '>', '<', '=' }, StringSplitOptions.RemoveEmptyEntries);
            var varNombre = partes[0].Trim();
            int valorComparar = int.Parse(partes[1].Trim());
            int valorActual = int.Parse(ValoresActuales.ContainsKey(varNombre) ? ValoresActuales[varNombre] : "0");

            if (l.Contains(">") && valorActual > valorComparar) {
                ejecutandoBloqueValido = true;
                saltarBloqueElse = true;
            }
            else if (l.Contains("<") && valorActual < valorComparar) {
                ejecutandoBloqueValido = true;
                saltarBloqueElse = true;
            }
            else {
                ejecutandoBloqueValido = false;
                saltarBloqueElse = false;
            }
            continue;
        }
        if (l.Contains("else"))
        {
            ejecutandoBloqueValido = !saltarBloqueElse;
            continue;
        }

        if (!ejecutandoBloqueValido) continue;

        if (l.Contains("cout <<"))
        {
            var partes = l.Split("<<");
            foreach (var parte in partes.Skip(1))
            {
                var item = parte.Replace(";", "").Replace("endl", "").Replace("\"", "").Trim();
                if (ValoresActuales.ContainsKey(item)) SalidaTerminal += ValoresActuales[item] + " ";
                else SalidaTerminal += item + " ";
            }
            SalidaTerminal += "\n";
        }
        else if (l.Contains("cin >>"))
        {
            var varNombre = l.Split(">>")[1].Replace(";", "").Trim();
            var resUser = await JSRuntime.InvokeAsync<string>("pedirDato", $"Ingrese {varNombre}:");
            semanticService.ActualizarValorDesdeInput(varNombre, resUser);
            ValoresActuales[varNombre] = resUser;
            SalidaTerminal += "> " + varNombre + ": " + resUser + "\n";
        }
        else if (l.Contains("="))
        {
            var partes = l.Split('=');
            var varDestino = partes[0].Replace("string", "").Replace("int", "").Replace("float", "").Trim();
            var valorNuevo = partes[1].Replace(";", "").Replace("\"", "").Trim();
            ValoresActuales[varDestino] = valorNuevo;
        }
        else if (l.StartsWith("return "))
        {
            var v = l.Replace("return", "").Replace(";", "").Trim();
            SalidaTerminal += "------------------------\nEXIT CODE: " + (ValoresActuales.ContainsKey(v) ? ValoresActuales[v] : v);
        }

        StateHasChanged();
        await Task.Delay(50);
    }
}
}