@page "/compilador"
@rendermode InteractiveServer
@using CompiladorCPLUS.Models
@using CompiladorCPLUS.Service
@inject CompiladorService compiladorService
@inject LexerService lexerService
@inject ParserService parserService
@inject SemanticService semanticService
@inject IJSRuntime JSRuntime

<PageTitle>IDE C+ Senior | UCNE</PageTitle>

<div class="container-fluid mt-4 px-4">
    <div class="row">
        <div class="col-lg-7">
            <div class="card bg-dark text-white shadow-lg border-0 mb-4">
                <div class="card-header border-secondary bg-gradient d-flex justify-content-between align-items-center py-3">
                    <h4 class="mb-0 text-primary fw-bold"><i class="bi bi-cpu me-2"></i>IDE C+ SENIOR</h4>
                    <div class="authors-badge">
                        <span class="badge rounded-pill bg-primary px-3 py-2 fw-bold shadow-sm">Luis Gabriel & James Ureña</span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <textarea @bind="compilacion.Codigo" class="form-control bg-black text-success font-monospace p-4 border-0" rows="18" style="outline: none; resize: none;"></textarea>
                </div>
                <div class="card-footer border-secondary bg-dark p-2 d-flex justify-content-center">
                    <button class="btn btn-primary fw-bold px-5" @onclick="Compilar">EJECUTAR PROGRAMA</button>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="bg-black text-white p-4 rounded shadow-lg mb-4" style="min-height: 480px; display: flex; flex-direction: column; border-left: 4px solid #0d6efd;">
                <div class="text-info border-bottom border-secondary pb-2 mb-3 small d-flex justify-content-between font-monospace">
                    <span>TERMINAL DE SALIDA</span>
                    <button class="btn btn-sm btn-outline-secondary py-0" @onclick='() => SalidaTerminal = ""'>LIMPIAR</button>
                </div>
                <div class="font-monospace flex-grow-1" style="white-space: pre-wrap; font-size: 0.9rem;">
                    @if (!string.IsNullOrEmpty(SalidaTerminal))
                    {
                        <span>@SalidaTerminal</span>
                    }
                    else
                    {
                        <span class="text-muted small">> Sistema listo para ejecución...</span>
                    }
                </div>
            </div>

            @if (errores.Any())
            {
                <div class="alert alert-danger bg-dark text-danger border-danger font-monospace shadow-sm">
                    <div class="fw-bold mb-2 border-bottom border-danger">DEBUGGER:</div>
                    @foreach (var error in errores)
                    {
                        <div class="small mb-1">@error</div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<script>
    window.pedirDato = (msg) => prompt(msg) || "";
</script>

@code {
    private Compilacion compilacion = new();
    private List<string> errores = new();
    private Dictionary<string, string> ValoresActuales = new();
    private string SalidaTerminal = "";

    private async Task Compilar()
    {
        SalidaTerminal = "";
        errores = lexerService.ValidarCodigo(compilacion.Codigo)
            .Concat(parserService.AnalizarSintaxis(compilacion.Codigo))
            .Concat(semanticService.AnalizarSemantica(compilacion.Codigo)).ToList();

        ValoresActuales.Clear();

        if (!errores.Any())
        {
            await EjecutarInterpretacion();
        }

        await compiladorService.Guardar(compilacion);
    }

    private async Task EjecutarInterpretacion()
    {
        var lineas = compilacion.Codigo.Split('\n');
        int i = 0;
        bool enMain = false;
        int safety = 0;

        while (i < lineas.Length && safety < 5000)
        {
            var l = lineas[i].Trim();
            safety++;

            if (!enMain)
            {
                if (l.Contains("main()")) enMain = true;
                i++; continue;
            }

            if (string.IsNullOrEmpty(l) || l.StartsWith("#") || l.Contains("using") || l == "{")
            {
                i++; continue;
            }

            if (l.StartsWith("for"))
            {
                var partes = l.Split('(', ')')[1].Split(';');

                string init = partes[0];
                string cond = partes[1];
                string step = partes[2];

                ProcesarAsignacionSilenciosa(init);

                int inicioBloque = i + 1;
                int finBloque = SaltarBloque(lineas, i) - 1;

                while (EvaluarCondicion(cond))
                {
                    for (int j = inicioBloque; j < finBloque; j++)
                    {
                        var lineaInterna = lineas[j].Trim();

                        if (lineaInterna.Contains("cout <<")) await ProcesarCout(lineaInterna);
                        else if (lineaInterna.Contains("cin >>")) await ProcesarCin(lineaInterna);
                        else if (lineaInterna.Contains("=") || lineaInterna.Contains("++"))
                            ProcesarAsignacionSilenciosa(lineaInterna);
                    }

                    ProcesarAsignacionSilenciosa(step);
                }

                i = finBloque + 1;
                continue;
            }

            if (l.StartsWith("if") || l.StartsWith("while"))
            {
                if (EvaluarCondicion(l.Split('(', ')')[1])) i++;
                else i = SaltarBloque(lineas, i);
                continue;
            }

            if (l == "}") break;

            if (l.Contains("cout <<")) await ProcesarCout(l);
            else if (l.Contains("cin >>")) await ProcesarCin(l);
            else if (l.Contains("=") || l.Contains("++")) ProcesarAsignacionSilenciosa(l);

            i++;
            StateHasChanged();
        }
    }

    private void ProcesarAsignacionSilenciosa(string l)
    {
        l = l.Replace(";", "").Trim();
        if (string.IsNullOrEmpty(l)) return;

        if (l.Contains("++"))
        {
            string v = l.Replace("++", "").Trim();
            ValoresActuales[v] = (GetVal(v) + 1).ToString();
        }
        else if (l.Contains("="))
        {
            var p = l.Split('=');
            string d = p[0].Trim();

            if (d.Contains("int ")) d = d.Replace("int ", "");
            if (d.Contains("float ")) d = d.Replace("float ", "");
            if (d.Contains("long ")) d = d.Replace("long ", "");
            if (d.Contains("double ")) d = d.Replace("double ", "");

            if (d.Contains(" ")) d = d.Split(' ').Last();

            ValoresActuales[d.Trim()] = EvaluarMath(p[1]).ToString();
        }
    }

    private double EvaluarMath(string e)
    {
        e = e.Trim().Replace(";", "");

        while (e.Contains("(") && e.Contains(")"))
        {
            int inicio = e.LastIndexOf("(");
            int fin = e.IndexOf(")", inicio);
            string subExpr = e.Substring(inicio + 1, fin - inicio - 1);
            double resultadoSub = EvaluarMath(subExpr);
            e = e.Remove(inicio, fin - inicio + 1).Insert(inicio, resultadoSub.ToString());
        }

        if (e.Contains("+"))
        {
            var p = e.Split('+', 2);
            return EvaluarMath(p[0]) + EvaluarMath(p[1]);
        }

        if (e.Contains("-") && !e.StartsWith("-"))
        {
            var p = e.Split('-', 2);
            return EvaluarMath(p[0]) - EvaluarMath(p[1]);
        }

        if (e.Contains("*"))
        {
            var p = e.Split('*', 2);
            return EvaluarMath(p[0]) * EvaluarMath(p[1]);
        }

        if (e.Contains("/"))
        {
            var p = e.Split('/', 2);
            return EvaluarMath(p[0]) / EvaluarMath(p[1]);
        }

        return GetVal(e);
    }

    private bool EvaluarCondicion(string c)
    {
        string[] ops = { "<=", ">=", "==", "!=", "<", ">" };

        foreach (var op in ops)
        {
            if (c.Contains(op))
            {
                var p = c.Split(new[] { op }, StringSplitOptions.None);
                double v1 = GetVal(p[0]);
                double v2 = GetVal(p[1]);

                return op switch
                {
                    "<=" => v1 <= v2,
                    ">=" => v1 >= v2,
                    "==" => v1 == v2,
                    "!=" => v1 != v2,
                    "<" => v1 < v2,
                    ">" => v1 > v2,
                    _ => false
                };
            }
        }

        return false;
    }

    private double GetVal(string s)
    {
        s = s.Trim();
        if (string.IsNullOrEmpty(s)) return 0;
        if (double.TryParse(s, out double n)) return n;
        return double.Parse(ValoresActuales.GetValueOrDefault(s, "0"));
    }

    private int SaltarBloque(string[] ls, int idx)
    {
        int b = 1;
        while (b > 0 && idx < ls.Length - 1)
        {
            idx++;
            if (ls[idx].Contains("{")) b++;
            if (ls[idx].Contains("}")) b--;
        }
        return idx + 1;
    }

    private async Task ProcesarCout(string l)
    {
        var ps = l.Split("<<");
        foreach (var p in ps.Skip(1))
        {
            var s = p.Replace(";", "").Replace("endl", "").Replace("\"", "").Trim();
            if (p.Contains("\"")) SalidaTerminal += s;
            else SalidaTerminal += EvaluarMath(s).ToString() + " ";
        }
        SalidaTerminal += "\n";
    }

    private async Task ProcesarCin(string l)
    {
        var vs = l.Replace("cin", "").Replace(";", "").Split(new[] { ">>" }, StringSplitOptions.RemoveEmptyEntries);

        foreach (var vRaw in vs)
        {
            var v = vRaw.Trim();
            if (string.IsNullOrEmpty(v)) continue;

            string res = await JSRuntime.InvokeAsync<string>("pedirDato", $"Ingrese {v}:");
            ValoresActuales[v] = string.IsNullOrEmpty(res) ? "0" : res;
            SalidaTerminal += ValoresActuales[v] + "\n";
        }
    }
}