@page "/compilador"
@rendermode InteractiveServer
@using CompiladorCPLUS.Models
@using CompiladorCPLUS.Service
@inject CompiladorService compiladorService
@inject LexerService lexerService
@inject ParserService parserService
@inject SemanticService semanticService
@inject IJSRuntime JSRuntime

<PageTitle>IDE C+ Interactiva | UCNE</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8">
            <div class="card bg-dark text-white shadow-lg border-0 mb-4">
                <div class="card-header border-secondary bg-gradient d-flex justify-content-between align-items-center">
                    <h4 class="mb-0 text-primary"><i class="bi bi-code-slash"></i> IDE INTERACTIVO</h4>
                    <div class="text-muted small">Luis Gabriel & James Ureña</div>
                </div>
                <div class="card-body p-0">
                    <textarea @bind="compilacion.Codigo" class="form-control bg-black text-success font-monospace p-4 border-0" rows="12" style="outline: none; resize: none;"></textarea>
                </div>
                <div class="card-footer border-secondary bg-dark p-3">
                    <button class="btn btn-primary w-100 fw-bold shadow" @onclick="Compilar">EJECUTAR PROGRAMA</button>
                </div>
            </div>

            <div class="bg-black text-white p-3 rounded shadow mb-4" style="min-height: 180px; border-left: 5px solid #0d6efd;">
                <div class="text-info border-bottom border-secondary pb-1 mb-2 small d-flex justify-content-between font-monospace">
                    <span>TERMINAL DE SALIDA</span>
                    <button class="btn btn-sm btn-outline-secondary py-0" style="font-size: 0.7rem;" @onclick='() => SalidaTerminal = ""'>LIMPIAR</button>
                </div>
                <div class="font-monospace" style="white-space: pre-wrap; font-size: 0.9rem;">
                    @if (!string.IsNullOrEmpty(SalidaTerminal))
                    {
                        <span>@SalidaTerminal</span>
                    }
                    else
                    {
                        <span class="text-muted small">> Esperando ejecución...</span>
                    }
                </div>
            </div>

            @if (errores.Any())
            {
                <div class="alert alert-danger bg-dark text-danger border-danger small font-monospace">
                    @foreach (var error in errores)
                    {
                        <div><i class="bi bi-exclamation-triangle-fill me-2"></i>@error</div>
                    }
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card border-info bg-dark text-white shadow">
                <div class="card-header bg-info text-dark fw-bold text-center small">TABLA DE SÍMBOLOS (RAM)</div>
                <div class="card-body p-0">
                    <table class="table table-dark table-sm mb-0 text-center small">
                        <thead><tr><th>Var</th><th>Tipo</th><th>Valor</th></tr></thead>
                        <tbody>
                            @foreach (var item in VariablesEnMemoria)
                            {
                                <tr>
                                    <td class="text-info">@item.Key</td>
                                    <td><span class="badge bg-primary">@item.Value</span></td>
                                    <td class="text-warning">@(ValoresActuales.ContainsKey(item.Key) ? ValoresActuales[item.Key] : "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    window.pedirDato = (mensaje) => {
        return prompt(mensaje) || "";
    };
</script>

@code {
    private Compilacion compilacion = new();
    private List<string> errores = new();
    private Dictionary<string, string> VariablesEnMemoria = new();
    private Dictionary<string, string> ValoresActuales = new();
    private string SalidaTerminal = "";

    private async Task Compilar()
    {
        SalidaTerminal = "> Compilando código...\n";

        var errLex = lexerService.ValidarCodigo(compilacion.Codigo);
        var errSin = parserService.AnalizarSintaxis(compilacion.Codigo);
        var errSem = semanticService.AnalizarSemantica(compilacion.Codigo);

        errores = errLex.Concat(errSin).Concat(errSem).ToList();
        VariablesEnMemoria = semanticService.ObtenerTablaSimbolos();
        ValoresActuales = semanticService.ObtenerValores();

        if (!errores.Any())
        {
            SalidaTerminal += "> Análisis exitoso. Ejecutando binario...\n------------------------\n";
            await EjecutarInterpretacion();
        }
        else
        {
            SalidaTerminal += "!! Errores detectados en la compilación.\n";
        }

        compilacion.TieneErrores = errores.Any();
        compilacion.Fecha = DateTime.Now;
        compilacion.ResultadoAnalisis = errores.Any() ? "Errores" : "Exito";
        await compiladorService.Guardar(compilacion);
    }

    private async Task EjecutarInterpretacion()
    {
        var lineas = compilacion.Codigo.Split('\n');
        foreach (var lineaRaw in lineas)
        {
            var l = lineaRaw.Trim();
            if (string.IsNullOrEmpty(l) || l.StartsWith("#") || l.StartsWith("using") || l.Contains("main") || l == "{" || l == "}") continue;

            if (l.Contains("cout <<"))
            {
                var partes = l.Split("<<");
                foreach (var parte in partes.Skip(1))
                {
                    var item = parte.Replace(";", "").Replace("endl", "").Replace("\"", "").Trim();
                    if (ValoresActuales.ContainsKey(item)) SalidaTerminal += ValoresActuales[item];
                    else SalidaTerminal += item;
                }
                SalidaTerminal += "\n";
            }
            else if (l.Contains("cin >>"))
            {
                var varNombre = l.Split(">>")[1].Replace(";", "").Trim();
                var resUser = await JSRuntime.InvokeAsync<string>("pedirDato", $"Ingrese {varNombre}:");
                semanticService.ActualizarValorDesdeInput(varNombre, resUser);
                ValoresActuales[varNombre] = resUser;
                SalidaTerminal += "> " + varNombre + ": " + resUser + "\n";
            }
            else if (l.Contains("input("))
            {
                var msg = l.Split('(', ')')[1].Replace("\"", "");
                var resUser = await JSRuntime.InvokeAsync<string>("pedirDato", msg);
                var varDestino = l.Split('=')[0].Replace("string", "").Replace("int", "").Replace("float", "").Trim();

                semanticService.ActualizarValorDesdeInput(varDestino, resUser);
                ValoresActuales[varDestino] = resUser;
                SalidaTerminal += "> " + msg + ": " + resUser + "\n";
            }
            else if (l.Contains("print("))
            {
                var contenido = l.Split('(', ')')[1].Replace("\"", "").Trim();
                SalidaTerminal += (ValoresActuales.ContainsKey(contenido) ? ValoresActuales[contenido] : contenido) + "\n";
            }
            else if (l.StartsWith("return "))
            {
                var v = l.Replace("return", "").Replace(";", "").Trim();
                var valorFinal = ValoresActuales.ContainsKey(v) ? ValoresActuales[v] : v;
                SalidaTerminal += "------------------------\nEXIT CODE: " + valorFinal;
            }
            StateHasChanged();
            await Task.Delay(50);
        }
    }
}